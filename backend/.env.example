# live | mock  (mock needs no API key)
LLM_MODE=mock
GEMINI_API_KEY=
# Required when LLM_MODE=live, e.g. gemini-2.5-flash
GEMINI_MODEL=
# Set to true if your key is a Vertex AI (express mode) key
GOOGLE_GENAI_USE_VERTEXAI=false
PORT=8080
CORS_ORIGIN=*
# memory | firestore
STORE=memory
LOG_LEVEL=info
